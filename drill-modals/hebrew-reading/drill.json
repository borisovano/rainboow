    "project": "hebrew-reading-lab",
    "adaptation": "Original HTML, styling, word bank and reading behavior retained; game completion bridge and adult fallback added."
  },
  "parameters": {
    "wordIndex": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 10000,
      "description": "Starting index within the filtered word bank; wraps around."
    },
    "wordLength": {
      "type": "string",
      "enum": [
        "grade",
        "all",
        "2",
        "3",
        "4",
        "5"
      ],
      "default": "grade",
      "description": "Use the selected grade, or override the length for manual exploration."
    },
    "word": {
      "type": "string",
      "default": "",
      "description": "Optional exact word (with or without niqqud). Must be in the filtered word bank.",
      "maxLength": 40
    },
    "sound": {
      "type": "boolean",
      "default": true,
      "description": "Enable optional success and retry sounds."
    },
    "allowAdultConfirmation": {
      "type": "boolean",
      "default": true,
      "description": "Offer explicit adult confirmation when speech recognition is unavailable."
    },
    "grade": {
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 4,
      "description": "Selected school class: 1 → 2 letters, 2 → 3, 3 → 4, 4 → 5. Used when wordLength is grade."
    }
  },
